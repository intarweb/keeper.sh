 // Simplified WebAuthn JSON shapes, assuming inputs conform to @simplewebauthn/types.
 
+enum PasskeyOptionsError: LocalizedError {
+  case missingField(String)
+  case invalidField(String)
+
+  var errorDescription: String? {
+    switch self {
+    case .missingField(let field):
+      return "Passkey options are missing required field '\(field)'."
+    case .invalidField(let field):
+      return "Passkey options contain an invalid '\(field)' field."
+    }
+  }
+}
+
+private func requiredString(_ key: String, in dict: [String: Any], path: String) throws -> String {
+  guard let value = dict[key] as? String else {
+    throw PasskeyOptionsError.missingField("\(path).\(key)")
+  }
+  guard !value.isEmpty else {
+    throw PasskeyOptionsError.invalidField("\(path).\(key)")
+  }
+  return value
+}
+
+private func requiredDictionary(_ key: String, in dict: [String: Any], path: String) throws -> [String: Any] {
+  guard let value = dict[key] as? [String: Any] else {
+    throw PasskeyOptionsError.missingField("\(path).\(key)")
+  }
+  return value
+}
+
