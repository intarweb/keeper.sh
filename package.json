{
  "name": "keeper.sh",
  "devDependencies": {
    "knip": "5.80.0",
    "oxlint": "^1.55.0",
    "rimraf": "^6.1.3",
    "turbo": "^2.9.0"
  },
  "license": "AGPL-3.0-only",
  "overrides": {
    "arktype": "^2.2.0",
    "react-native-screens": "4.26.2"
  },
  "packageManager": "bun@1.3.11",
  "private": true,
  "scripts": {
    "clean": "rimraf --glob **/{.turbo,node_modules,.next/}/",
    "dev": "turbo run dev dev:root",
    "dev:root": "docker compose up --force-recreate",
    "types": "turbo run types --parallel",
    "build": "turbo run build",
    "start": "turbo run start",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "unused": "knip"
  },
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "applications/*",
      "services/*"
    ]
  },
  "patchedDependencies": {
    "@ark/schema@0.56.0": "patches/@ark%2Fschema@0.56.0.patch",
    "expo-better-auth-passkey@1.4.1": "patches/expo-better-auth-passkey@1.4.1.patch"
  }
}
